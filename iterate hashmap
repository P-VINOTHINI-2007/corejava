package arraylist;
import java.util.HashMap;
import java.util.Map;

public class hashmap {
    public static void main(String[]args){
        HashMap<String,String> map=new HashMap<>();
        // to store key value pairs in hashmap
        map.put("name","vinothini");
        map.put("house no","1/204");
        map.put("area","pavalandhur");
        map.put("district","Dharmapuri");
        System.out.println("original map:"+map);


        // update the element in hashmap
        map.put("house no","1/36A");
        System.out.println("after upadate the house no:"+map);
        // get()-> using key get the value
        System.out.println("area:"+map.get("area"));
// containsKey()->to check key is exit an map
System.out.println("district contains"+map.containsKey("district"));
System.out.println("district contains"+map.containsValue("vinothini"));
// find the size of map
System.out.println("size:"+map.size());

 // remove any element
map.remove("area");
// iterate over  map
for (Map.Entry<String, String> dataset : map.entrySet()) {
// retrive key
    String key=dataset.getKey();
    // retrive value
    String value=dataset.getValue();
    System.out.println(key+":"+value);

}
System.out.println("keys on Map"+map.keySet());
    }

    
    

    
}
