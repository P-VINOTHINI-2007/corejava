public class reversenum {
    public int reverseNumber(int n){
        int rev=0;
        while(n>0){
            int rem = n%10;
            rev=rev*10+rem;
            n=n/10;
        }
        return rev;

    }
    public static void main(String[]args){
    
        reversenum obj=new reversenum();
        System.out.println("Rev of 12345:"+obj.reverseNumber(12345));
        System.out.println("Rev of 2007:"+obj.reverseNumber(2007));
        System.out.println("Rev of 2005:"+obj.reverseNumber(2005));
    }
    
}
