package string;

public class removestr {
    public static void main(String[]args){
        String s="vino abi";
        String strreplace=s.replace("","");
        System.out.println("remove the space:"+strreplace);
        // using for loop
        String newString=" ";
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            if(ch !=' ' ){
                newString=newString+ch;

            }

            }
            System.out.println("after removing the space:"+newString);
        }
    }
    

